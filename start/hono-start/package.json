{
  "name": "base",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:server": "vite build",
    "build:client": "vite build --config vite.config.client.ts",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:ci": "vitest run",
    "prepare": "husky"
  },
  "dependencies": {
    "@cmtlyt/logger": "^0.5.0",
    "@hono/event-emitter": "^2.0.0",
    "@hono/node-server": "^1.19.11",
    "@hono/trpc-server": "^0.4.2",
    "@hono/zod-openapi": "^1.2.2",
    "@scalar/hono-api-reference": "^0.10.0",
    "@trpc/client": "^11.11.0",
    "@trpc/server": "^11.11.0",
    "hono": "^4.12.5",
    "yoctocolors": "^2.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@hono/vite-dev-server": "^0.25.0",
    "@types/node": "^20.11.17",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "vite": "8.0.0-beta.16",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write"
    ]
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.0.0"
    },
    "packageManager": {
      "name": "pnpm"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist-client/client-sdk.js",
  "module": "./dist-client/client-sdk.js",
  "types": "./dist-client/client-sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist-client/client-sdk.d.ts",
      "node": "./dist-client/client-sdk.js",
      "default": "./dist-client/client-sdk.js"
    }
  },
  "files": [
    "dist-client"
  ]
}
